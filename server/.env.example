PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pixelforge
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000

# ---------- Sprite Forge: AI image provider (server-side only; never put keys in client/.env.local) ----------
# mock   = offline procedural images, no key, no login required (default)
# openai = OpenAI Images API (generations for masters, edits + mask for variants); login required
AI_PROVIDER=mock

# OpenAI (only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# gpt-image-1 was shut down on 2026-10-23. Current: gpt-image-2.5-sunburst (detail, precise edits) | gpt-image-2.5-flare (faster)
#   | gpt-image-2.6-sunburst / -flare (newer; mask support for 2.6 not confirmed in the docs)
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# image understanding + chat ("Đọc ảnh", "Trợ lý AI") via the Responses API. gpt-6.1-terra | gpt-6-luna (cheapest) | gpt-6.1-sol | gpt-6-astra
OPENAI_VISION_MODEL=gpt-6.1-terra
# low | medium | high | auto
OPENAI_IMAGE_QUALITY=medium
# transparent | opaque | auto (empty = provider default). "transparent" lets the pipeline skip background removal.
OPENAI_IMAGE_BACKGROUND=
# Only for gpt-image-1.5 ("high"/"low"). Leave EMPTY for gpt-image-2.x (always high fidelity; sending it may error).
OPENAI_INPUT_FIDELITY=

# Limits / cost control
AI_MAX_CANDIDATES=4
AI_MAX_UPLOAD_MB=8
# images per user per day (in-memory counter, resets when the server restarts)
AI_DAILY_IMAGE_LIMIT=40
# "Đọc ảnh" + chat messages per user per day (in-memory)
AI_DAILY_CHAT_LIMIT=200
AI_TIMEOUT_MS=180000
AI_MAX_RETRIES=1
# rough per-image price used only for the cost estimate shown in the UI - check your provider's current pricing
AI_COST_PER_IMAGE_USD=0.05

# ---------- Asset storage (original source images, cleaned images, masks) ----------
# default: server/storage/assets ; one sub-folder per user
STORAGE_DIR=
ASSET_MAX_UPLOAD_MB=16
